<Window x:Class="RepoBoss.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RepoBoss" Width="1440" Height="900" MinWidth="1040" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#7CB7FF" Offset="0"/>
                  <GradientStop Color="#C39BFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="R" FontWeight="Bold" FontSize="17" Foreground="#0F1216"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="RepoBoss" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Text="Windows app" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="20,0,20,20" TextWrapping="Wrap" Foreground="{StaticResource Demo}"
                   Text="Demo adapters verify the pipeline, not a model. Small samples are not a ranking."/>
        <StackPanel x:Name="NavPanel">
          <RadioButton Style="{StaticResource Nav}" Content="Overview" Tag="Overview" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Challenges" Tag="Challenges" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="New challenge" Tag="New" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Run agent" Tag="Run" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Runs" Tag="Runs" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Compare" Tag="Compare" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource Nav}" Content="Settings" Tag="Settings" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="26,20,26,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="170"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14">
        <TextBlock x:Name="WorkspaceText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
        <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"/>
      </DockPanel>

      <Grid Grid.Row="1">
        <!-- Overview -->
        <DockPanel x:Name="PageOverview">
          <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14" Margin="0,0,12,0">
              <StackPanel><TextBlock x:Name="StatChallenges" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Challenges" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14" Margin="0,0,12,0">
              <StackPanel><TextBlock x:Name="StatLanguages" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Languages" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14" Margin="0,0,12,0">
              <StackPanel><TextBlock x:Name="StatRuns" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Runs by real agents" Foreground="{StaticResource Muted}"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14">
              <StackPanel><TextBlock x:Name="StatPassed" Text="-" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ok}"/>
                <TextBlock Text="Passed (real agents)" Foreground="{StaticResource Muted}"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                     Text="Per agent, all challenges. Results describe this environment; they are not a general ranking."/>
          <DataGrid x:Name="StatsGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="180"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="220"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
              <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="90"/>
              <DataGridTextColumn Header="Passed" Binding="{Binding Passed}" Width="80"/>
              <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="80"/>
              <DataGridTextColumn Header="Median s" Binding="{Binding Median}" Width="90"/>
              <DataGridTextColumn Header="Outcomes" Binding="{Binding Outcomes}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- Challenges -->
        <Grid x:Name="PageChallenges" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
          </Grid.RowDefinitions>
          <DataGrid x:Name="ChallengesGrid" SelectionChanged="ChallengesGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
              <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="100"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
              <DataGridTextColumn Header="Trusted" Binding="{Binding Trusted}" Width="80"/>
              <DataGridTextColumn Header="Runner" Binding="{Binding Runner}" Width="80"/>
              <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="1" Margin="0,10">
            <Button Style="{StaticResource AccentButton}" Content="Run an agent on it" Click="ChallengeRun_Click"/>
            <Button Style="{StaticResource Btn}" Content="Re-verify" Click="ChallengeVerify_Click"/>
            <Button Style="{StaticResource Btn}" Content="Reveal bug" Click="ChallengeReveal_Click"/>
            <Button Style="{StaticResource Btn}" Content="Export…" Click="ChallengeExport_Click"/>
            <Button Style="{StaticResource Btn}" Content="Import…" Click="ChallengeImport_Click"/>
          </WrapPanel>
          <TextBox x:Name="ChallengeDetail" Grid.Row="2" Style="{StaticResource Code}"/>
        </Grid>

        <!-- New challenge -->
        <StackPanel x:Name="PageNew" Visibility="Collapsed">
          <TextBlock Text="Repository folder" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Detect" Click="Detect_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="RepoBox" Height="32" VerticalContentAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="Bug types" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <CheckBox x:Name="TConfig" Content="config_value" IsChecked="True"/>
            <CheckBox x:Name="TPath" Content="path_reference" IsChecked="True"/>
            <CheckBox x:Name="TLogic" Content="logic_condition" IsChecked="True"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Seed" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SeedBox" Text="0" Width="70" Height="30" VerticalContentAlignment="Center" Margin="0,0,22,0"/>
            <TextBlock Text="Challenges per bug type" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="PerBox" Text="1" Width="50" Height="30" VerticalContentAlignment="Center" Margin="0,0,22,0"/>
            <TextBlock Text="Runner" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="NewRunner" Width="120" SelectedIndex="0">
              <ComboBoxItem Content="docker"/><ComboBoxItem Content="local"/>
            </ComboBox>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16" MaxWidth="900" HorizontalAlignment="Left"
                     Text="Without a repoboss.toml the project type is detected automatically (npm, Cargo, .NET, Maven, Gradle, Go, CMake, Python…). docker = isolated; local = NOT isolated, for trusted code only. Creating a challenge runs the test suite several times."/>
          <Button Style="{StaticResource AccentButton}" Content="Create challenges" HorizontalAlignment="Left" Click="Create_Click"/>
        </StackPanel>

        <!-- Run agent -->
        <StackPanel x:Name="PageRun" Visibility="Collapsed">
          <TextBlock Text="Challenge" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <ComboBox x:Name="RunChallenge" Width="620" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <TextBlock Text="Agent" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
          <ComboBox x:Name="RunAgent" Width="320" HorizontalAlignment="Left" Margin="0,0,0,6" SelectionChanged="RunAgent_SelectionChanged"/>
          <TextBlock x:Name="AgentInfo" Foreground="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="Attempts" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="AttemptsBox" Text="1" Width="60" Height="30" VerticalContentAlignment="Center" Margin="0,0,22,0"/>
            <TextBlock Text="Time limit (s)" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TimeoutBox" Width="80" Height="30" VerticalContentAlignment="Center" Margin="0,0,22,0"/>
            <TextBlock Text="Runner" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="RunRunner" Width="120" SelectedIndex="0">
              <ComboBoxItem Content="docker"/><ComboBoxItem Content="local"/>
            </ComboBox>
          </StackPanel>
          <Button Style="{StaticResource AccentButton}" Content="Run" HorizontalAlignment="Left" Click="RunAgent_Click"/>
          <TextBlock x:Name="AgentsPath" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Runs -->
        <Grid x:Name="PageRuns" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="6*"/>
          </Grid.ColumnDefinitions>
          <DataGrid x:Name="RunsGrid" SelectionChanged="RunsGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Run" Binding="{Binding Id}" Width="110"/>
              <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="130"/>
              <DataGridTextColumn Header="Challenge" Binding="{Binding Challenge}" Width="110"/>
              <DataGridTemplateColumn Header="Outcome" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeBrush}" FontWeight="SemiBold"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="P/F/E" Binding="{Binding Tests}" Width="80"/>
              <DataGridTextColumn Header="Seconds" Binding="{Binding Seconds}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <RichTextBox x:Name="RunDetail" Grid.Column="2" Background="#0B0E11" Foreground="#CFD6DE" BorderBrush="{StaticResource Line}"
                       FontFamily="{StaticResource Mono}" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" Padding="8"/>
        </Grid>

        <!-- Compare -->
        <DockPanel x:Name="PageCompare" Visibility="Collapsed">
          <ComboBox x:Name="CompareChallenge" DockPanel.Dock="Top" Width="620" HorizontalAlignment="Left" Margin="0,0,0,12"
                    SelectionChanged="CompareChallenge_SelectionChanged"/>
          <TextBlock x:Name="CompareNote" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
          <DataGrid x:Name="CompareGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="180"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="220"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
              <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="90"/>
              <DataGridTextColumn Header="Passed" Binding="{Binding Passed}" Width="80"/>
              <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="80"/>
              <DataGridTextColumn Header="Median s" Binding="{Binding Median}" Width="90"/>
              <DataGridTextColumn Header="Outcomes" Binding="{Binding Outcomes}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- Settings -->
        <DockPanel x:Name="PageSettings" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="RepoBoss command (repoboss.exe, or python with -m repoboss)" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Browse…" Click="BrowseCommand_Click" Margin="8,0,0,0"/>
              <TextBox x:Name="CommandBox" Height="32" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Workspace folder (.repoboss)" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Browse…" Click="BrowseHome_Click" Margin="8,0,0,0"/>
              <TextBox x:Name="HomeBox" Height="32" VerticalContentAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,16">
              <Button Style="{StaticResource AccentButton}" Content="Save and reload" Click="SaveSettings_Click"/>
              <Button Style="{StaticResource Btn}" Content="Create workspace (docker)" Click="InitDocker_Click"/>
              <Button Style="{StaticResource Btn}" Content="Create workspace (local)" Click="InitLocal_Click"/>
              <Button Style="{StaticResource Btn}" Content="Doctor" Click="Doctor_Click"/>
              <Button Style="{StaticResource Btn}" Content="Install RepoBoss CLI (pip)" Click="InstallCli_Click"/>
            </WrapPanel>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Save agents.toml" Click="SaveAgents_Click"/>
              <TextBlock x:Name="AgentsFileText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
          <TextBox x:Name="AgentsEditor" Style="{StaticResource Code}" IsReadOnly="False" AcceptsReturn="True" AcceptsTab="True"/>
        </DockPanel>
      </Grid>

      <!-- Activity -->
      <DockPanel Grid.Row="2" Margin="0,14,0,6">
        <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Stop" IsEnabled="False" Click="Stop_Click" Margin="0"/>
        <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="180" Height="6" Margin="0,0,12,0" IsIndeterminate="False"
                     Background="{StaticResource Panel2}" Foreground="{StaticResource Accent}" BorderThickness="0"/>
        <TextBlock Text="Activity" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="LogBox" Grid.Row="3" Style="{StaticResource Code}"/>
    </Grid>
  </Grid>
</Window>
