<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not "RepoBoss": Windows resolves the "repoboss" CLI command to an exe with that name in the app folder. -->
    <AssemblyName>RepoBossApp</AssemblyName>
    <RootNamespace>RepoBoss.Windows</RootNamespace>
    <Version>0.2.1</Version>
    <Product>RepoBoss</Product>
    <Description>Native Windows interface for RepoBoss</Description>
    <Copyright>The RepoBoss contributors, MIT License</Copyright>
    <ApplicationIcon>repoboss.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="repoboss.ico" />
  </ItemGroup>

</Project>
